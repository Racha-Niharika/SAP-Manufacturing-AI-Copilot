<mvc:View
    controllerName="manufacturingui.controller.AICopilot"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    height="100%"
    class="copilot-view-root">

    <VBox height="100%" fitContainer="true" class="copilot-main-vbox">

        <!-- Top Header Bar -->
        <HBox class="copilot-header" justifyContent="SpaceBetween" alignItems="Center">
            <HBox alignItems="Center">
                <core:Icon src="sap-icon://da-2" size="1.6rem" color="#ffffff" class="sapUiTinyMarginEnd copilot-header-icon" />
                <VBox>
                    <HBox alignItems="Center">
                        <Title text="Manufacturing AI Copilot" level="H4" class="copilot-title" />
                        <ObjectStatus 
                            text="{= ${chat>/isThinking} ? 'Thinking...' : 'Active' }" 
                            state="{= ${chat>/isThinking} ? 'Warning' : 'Success' }" 
                            icon="{= ${chat>/isThinking} ? 'sap-icon://synchronize' : 'sap-icon://sys-enter-2' }"
                            class="copilot-status-badge sapUiTinyMarginBegin" />
                    </HBox>
                    <Text text="Live SAP S/4HANA &amp; SOP Vector AI Assistant" class="copilot-subtitle" />
                </VBox>
            </HBox>
            <HBox alignItems="Center" class="copilot-header-actions">
                <Button id="btnNewChat" 
                    icon="sap-icon://add" 
                    text="New Chat"
                    tooltip="Start a new conversation" 
                    type="Transparent" 
                    press=".onClearChat" 
                    class="copilot-newchat-btn sapUiTinyMarginEnd" />
                <Button id="btnToggleMaximize" 
                    icon="{= ${chat>/isMaximized} ? 'sap-icon://exit-full-screen' : 'sap-icon://full-screen' }" 
                    tooltip="{= ${chat>/isMaximized} ? 'Restore Normal Width' : 'Expand / Maximize Window' }" 
                    type="Transparent" 
                    press=".onToggleMaximize" 
                    class="copilot-header-btn" />
                <Button id="btnCloseCopilot" 
                    icon="sap-icon://decline" 
                    tooltip="Close Panel" 
                    type="Transparent" 
                    press=".onClose" 
                    class="copilot-header-btn" />
            </HBox>
        </HBox>

        <!-- Scrollable Conversation / Q&A Canvas (Fits data completely) -->
        <ScrollContainer id="chatScroll" vertical="true" horizontal="false" class="copilot-chat-container">

            <!-- Conversation Messages List -->
            <VBox id="chatMessagesBox" items="{chat>/messages}" class="copilot-messages-list">
                <items>
                    <VBox class="copilot-turn-wrapper sapUiSmallMarginBottom">

                        <!-- 1. USER QUESTION TURN (Right-aligned Bubble) -->
                        <VBox visible="{= ${chat>sender} === 'User' }" class="copilot-user-turn">
                            <HBox justifyContent="End" alignItems="Center" class="copilot-meta-row sapUiTinyMarginBottom">
                                <Text text="You" class="copilot-author-name sapUiTinyMarginEnd" />
                                <Text text="{chat>timestamp}" class="copilot-meta-time sapUiTinyMarginEnd" />
                                <Avatar initials="U" displaySize="XS" class="copilot-user-avatar" />
                            </HBox>
                            <HBox justifyContent="End" width="100%">
                                <VBox class="copilot-user-bubble">
                                    <Text text="{chat>text}" class="copilot-user-prompt-text" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- 2. COPILOT ANSWER TURN (Left-aligned Card) -->
                        <VBox visible="{= ${chat>sender} !== 'User' }" class="copilot-bot-turn">
                            <HBox alignItems="Center" class="copilot-meta-row sapUiTinyMarginBottom">
                                <Avatar icon="sap-icon://da-2" displaySize="XS" class="copilot-bot-avatar sapUiTinyMarginEnd" />
                                <Text text="Manufacturing AI Copilot" class="copilot-author-name sapUiTinyMarginEnd" />
                                <Text text="{chat>timestamp}" class="copilot-meta-time" />
                            </HBox>

                            <VBox class="copilot-bot-card">
                                <!-- Tool Execution Badges -->
                                <HBox items="{chat>tools}" visible="{= ${chat>tools}.length &gt; 0 }" class="copilot-tools-bar">
                                    <items>
                                        <HBox class="copilot-tool-chip {= ${chat>tool}.indexOf('sop') &gt; -1 ? 'rag-tool' : 'sap-tool' }">
                                            <core:Icon src="{= ${chat>tool}.indexOf('sop') &gt; -1 ? 'sap-icon://learning-assistant' : 'sap-icon://database' }" size="0.75rem" class="sapUiTinyMarginEnd" />
                                            <Text text="{chat>tool}" class="tool-name" />
                                            <Text text=" ({chat>status})" class="tool-status {= ${chat>status} === 'success' ? 'status-ok' : (${chat>status} === 'awaiting_confirmation' ? 'status-pending' : 'status-err') } sapUiTinyMarginBegin" />
                                        </HBox>
                                    </items>
                                </HBox>

                                <!-- Formatted Bot HTML Answer -->
                                <core:HTML content="{chat>html}" preferDOM="false" sanitizeContent="false" class="copilot-bot-html" />

                                <!-- Human-in-the-Loop (HITL) Confirmation Card -->
                                <VBox visible="{= Boolean(${chat>pendingAction}) }" class="copilot-confirm-card">
                                    <HBox alignItems="Center" justifyContent="SpaceBetween" class="copilot-confirm-header">
                                        <HBox alignItems="Center">
                                            <core:Icon src="sap-icon://validate" class="copilot-confirm-icon sapUiTinyMarginEnd" />
                                            <Text text="{chat>pendingAction/title}" class="copilot-confirm-title" />
                                        </HBox>
                                        <Text text="{chat>pendingAction/targetSystem}" class="copilot-confirm-system-badge" />
                                    </HBox>
                                    <Text text="{chat>pendingAction/message}" class="copilot-confirm-message" />
                                    <HBox
                                        visible="{= ${chat>pendingAction/status} === 'pending' }"
                                        alignItems="Center"
                                        class="copilot-confirm-actions">
                                        <Button
                                            text="Confirm"
                                            type="Emphasized"
                                            icon="sap-icon://accept"
                                            enabled="{= !${chat>pendingAction/busy} }"
                                            press=".onConfirmAction"
                                            class="copilot-confirm-btn-ok sapUiTinyMarginEnd" />
                                        <Button
                                            text="Cancel"
                                            type="Transparent"
                                            icon="sap-icon://decline"
                                            enabled="{= !${chat>pendingAction/busy} }"
                                            press=".onCancelAction"
                                            class="copilot-confirm-btn-cancel" />
                                        <BusyIndicator
                                            visible="{= Boolean(${chat>pendingAction/busy}) }"
                                            size="1rem"
                                            class="sapUiSmallMarginBegin" />
                                    </HBox>
                                    <HBox
                                        visible="{= ${chat>pendingAction/status} !== 'pending' }"
                                        alignItems="Center"
                                        class="copilot-confirm-resolved">
                                        <core:Icon
                                            src="{= ${chat>pendingAction/status} === 'confirmed' ? 'sap-icon://sys-enter-2' : (${chat>pendingAction/status} === 'failed' ? 'sap-icon://error' : 'sap-icon://sys-cancel-2') }"
                                            class="sapUiTinyMarginEnd" />
                                        <Text text="{chat>pendingAction/resolutionText}" class="copilot-confirm-status-text" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>

                    </VBox>
                </items>
            </VBox>

            <!-- Thinking Indicator (Live while waiting for answer) -->
            <VBox id="thinkingBox" visible="{chat>/isThinking}" class="copilot-thinking-turn sapUiSmallMarginBottom">
                <HBox alignItems="Center" class="copilot-meta-row sapUiTinyMarginBottom">
                    <Avatar icon="sap-icon://da-2" displaySize="XS" class="copilot-bot-avatar sapUiTinyMarginEnd" />
                    <Text text="Manufacturing AI Copilot" class="copilot-author-name sapUiTinyMarginEnd" />
                    <Text text="Thinking..." class="copilot-meta-time" />
                </HBox>
                <HBox alignItems="Center" class="copilot-thinking-bubble">
                    <BusyIndicator size="1.2rem" class="sapUiSmallMarginEnd" />
                    <VBox>
                        <Text text="Analyzing live SAP S/4HANA orders &amp; matching SOPs..." class="thinking-title" />
                        <Text text="Please wait while the AI generates the complete response..." class="thinking-subtitle" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- =========================================================
                 ASK NEXT QUESTION BOX (Appears directly after the answer)
                 ========================================================= -->
            <VBox class="copilot-next-question-card sapUiMediumMarginTop sapUiMediumMarginBottom">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                    <HBox alignItems="Center">
                        <core:Icon src="sap-icon://comment" size="1rem" color="#0070f2" class="sapUiTinyMarginEnd" />
                        <Text text="Ask Next Question:" class="copilot-next-q-title" />
                    </HBox>
                    <Text text="💡 Enter sends • Shift+Enter for new line" class="copilot-next-q-hint" />
                </HBox>

                <!-- Suggested Quick Prompts (Clickable chips right above textarea) -->
                <HBox wrap="Wrap" class="copilot-inline-suggestions sapUiTinyMarginBottom">
                    <Button text="📋 Order 1000001 status?" type="Ghost" press=".onSuggestionPress" class="copilot-inline-chip" />
                    <Button text="⚠️ Any delayed orders?" type="Ghost" press=".onSuggestionPress" class="copilot-inline-chip" />
                    <Button text="📦 In-progress orders?" type="Ghost" press=".onSuggestionPress" class="copilot-inline-chip" />
                    <Button text="📚 Material shortage SOP?" type="Ghost" press=".onSuggestionPress" class="copilot-inline-chip" />
                    <Button text="🔧 Machine breakdown SOP?" type="Ghost" press=".onSuggestionPress" class="copilot-inline-chip" />
                </HBox>

                <!-- Input Box with Auto-Growing Textarea & Direct Send Button -->
                <HBox alignItems="End" width="100%" class="copilot-inline-input-wrapper">
                    <TextArea id="questionInput"
                        placeholder="Type your next question here (e.g., 'what is its planned quantity?' or 'why is order 1000003 delayed?')..."
                        rows="2"
                        growing="true"
                        growingMaxLines="5"
                        width="100%"
                        valueLiveUpdate="true"
                        value="{chat>/currentInput}"
                        enabled="{= !${chat>/isThinking} }"
                        class="copilot-inline-textarea">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0" />
                        </layoutData>
                    </TextArea>
                    <Button id="btnSend"
                        icon="sap-icon://paper-plane"
                        text="Send"
                        type="Emphasized"
                        tooltip="Send Question (Enter)"
                        enabled="{= !${chat>/isThinking} }"
                        press=".onSendMessage" 
                        class="copilot-inline-send-btn sapUiTinyMarginBegin">
                        <layoutData>
                            <FlexItemData growFactor="0" />
                        </layoutData>
                    </Button>
                </HBox>

                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop copilot-inline-footer">
                    <Text text="Live SAP S/4HANA Cloud &amp; SOP Knowledge Assistant" class="copilot-hint-muted" />
                    <Text text="Ready for your next question" class="copilot-hint-muted" />
                </HBox>
            </VBox>

        </ScrollContainer>

    </VBox>
</mvc:View>
