# S/4HANA Public Cloud Credentials
cds.requires.API_PRODUCTION_ORDER_2_SRV_0001.credentials.url="https://<your-s4-host>/sap/opu/odata/sap/API_PRODUCTION_ORDER_2_SRV"
cds.requires.API_PRODUCTION_ORDER_2_SRV_0001.credentials.authentication="BasicAuthentication"
cds.requires.API_PRODUCTION_ORDER_2_SRV_0001.credentials.username="<username>"
cds.requires.API_PRODUCTION_ORDER_2_SRV_0001.credentials.password="<password>"

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-3.5-flash

# PostgreSQL & pgvector Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=admin
PGPASSWORD=localpassword
PGDATABASE=manufacturing_ai
